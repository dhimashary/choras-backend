@startuml activity
title CHORAS Geometry Pipeline — Activity (run_pipeline)

skinparam shadowing false
skinparam ActivityDiamondBackgroundColor #FAFAFA

start
:receive (geom, profile, output_path, ctx);

if (geom.kind == profile.target_ir.kind?) then (yes)
else (no)
  :ConverterRegistry.convert(geom, profile.target_ir);
endif

partition "PRE detection" {
  :run_validators(profile.pre_validators, when=PRE);
  :append ValidationSnapshot #0 (PRE);
}

partition "Staged repairs" {
  while (more stages?) is (yes)
    :stage = next(stages);

    partition "stage.repairs (ordered)" {
      while (more repairs in stage?) is (yes)
        :repair = next(stage.repairs);
        if (repair is iterative?) then (yes)
          repeat
            :repair.detector.detect();
            if (issues empty\nOR iters >= max_iters?) then (stop)
              break
            endif
            :repair.apply() on detected issues;
          repeat while (continue) is (loop) not (exit)
        else (no)
          :repair.apply(geom, issues_for_kind, ctx);
        endif
        :record RepairResult\n(step_name, stage_name,\n affected_ids, iterations);
      endwhile (no)
    }

    :run_validators(stage.post_validators,\n  when=POST_STAGE,\n  stage_name=stage.name);
    :append ValidationSnapshot #i;

    if (any issue.kind in stage.fail_fast_on?) then (yes)
      :raise PipelineFailFastError;
      stop
    endif
  endwhile (no)
}

partition "FINAL detection" {
  :run_validators(profile.final_validators,\n  when=FINAL);
  :append ValidationSnapshot #FINAL;
}

partition "Export (unconditional)" {
  while (more exporters?) is (yes)
    :exporter = next(profile.exporters);
    :target = exporter.path_for(output_path)\n         if defined else output_path;
    :exporter.write(geom, target);
  endwhile (no)
}

:return PipelineResult(geom, snapshots,\n  repairs, str(output_path));
stop

note right
  Snapshot diffing (diff_snapshots) and "is the result acceptable?"
  policy live in the calling service, NOT in run_pipeline. The pipeline
  always exports unless a stage fail_fast_on triggers.
end note

@enduml
